        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  whatsapp_message_id: $(\"Só mensagens de texto\").first().json.messages[0].id,\n  telefone: $(\"Só mensagens de texto\").first().json.messages[0].from,\n  cliente_nome: Array.from(String($(\"Só mensagens de texto\").first().json.contacts?.[0]?.profile?.name ?? \"\")).slice(0, 100).join(\"\") || null,\n  texto: Array.from(String($(\"Só mensagens de texto\").first().json.messages[0].text.body ?? \"\")).slice(0, 4096).join(\"\"),\n  resposta: Array.from(String($(\"Gerar resposta do turismo\").first().json.output.resposta)).slice(0, 4000).join(\"\"),\n  idioma: $(\"Gerar resposta do turismo\").first().json.output.idioma,\n  passeio_sugerido_id: $(\"Gerar resposta do turismo\").first().json.output.passeio_sugerido_id,\n  precisa_atencao_humana: $(\"Gerar resposta do turismo\").first().json.output.precisa_atencao_humana\n}) }}",
        "options": { "timeout": 10000 }
