      "typeVersion": 1,
      "position": [240, 300],
      "parameters": { "updates": ["messages"] },
      "credentials": {
        "whatsAppTriggerApi": { "name": "WhatsApp OAuth account" }
      }
    },
    {
      "id": "10e117d9-9455-499b-b7ff-bd00d50006e0",
      "name": "Só mensagens de texto",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [480, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.messages?.[0]?.type }}",
              "operator": { "type": "string", "operation": "equals" },
              "rightValue": "text"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "059b7bd7-c29e-40de-9114-629c16783809",
      "name": "Buscar catálogo de passeios",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [1200, 300],
      "parameters": {
        "method": "GET",
        "url": "<BACKEND_URL>/api/ingest/catalogo",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth"
