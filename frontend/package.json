{
  "name": "agente-turismo-lencois-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "size": "size-limit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.49.1",
    "@size-limit/file": "14.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "^10.4.20",
    "jscpd": "^5.3.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "size-limit": "14.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "size-limit": [
    {
      "name": "JavaScript (gzip)",
      "path": "dist/assets/*.js",
      "gzip": true,
      "limit": "110 kB"
    },
    {
      "name": "CSS (gzip)",
      "path": "dist/assets/*.css",
      "gzip": true,
      "limit": "8 kB"
    }
  ]
}
