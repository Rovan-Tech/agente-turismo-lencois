DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
DASHBOARD_API_TOKEN=
# Token do n8n para registrar atendimentos (ADR-0005). Diferente do DASHBOARD_API_TOKEN, que é
# público no bundle do painel. Vazio = rota fechada.
INGEST_API_TOKEN=
# Conversas sem atividade há mais dias que isso são apagadas (LGPD)
CONVERSATION_RETENTION_DAYS=90
WHISPER_MODEL_SIZE=base
# Teto (bytes) do áudio recebido; acima disso o turista recebe um aviso e nada é transcrito
MAX_AUDIO_BYTES=5242880
AGENCY_NAME=Agência de Turismo em Lençóis
FRONTEND_ORIGIN=https://agente-turismo-lencois.pages.dev
