{
  "enabledPlugins": {
    "rovan-community-skills@rovan-claude-kit": true,
    "rovan-project-kit@rovan-claude-kit": true
  },
  "extraKnownMarketplaces": {
    "rovan-claude-kit": {
      "source": {
        "source": "github",
        "repo": "Rovan-Tech/rovan-claude-kit"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(python scripts/quality_gate.py *)",
      "Bash(python3 scripts/quality_gate.py *)",
      "Bash(backend/.venv/bin/python scripts/quality_gate.py *)",
      "Bash(make gate*)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(backend/.venv/bin/python -m pytest *)",
      "Bash(ruff *)",
      "Bash(python -m ruff *)",
      "Bash(backend/.venv/bin/python -m ruff *)",
      "Bash(mypy *)",
      "Bash(python -m mypy *)",
      "Bash(backend/.venv/bin/python -m mypy *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git ls-files*)",
      "Bash(npm run *)",
      "Bash(npx prettier *)",
      "Bash(npx playwright test*)",
      "mcp__context7",
      "mcp__playwright"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.development)",
      "Read(./**/.env.test)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Edit(./.claude/state/**)",
      "Edit(./.claude/reports/**)"
    ]
  },
  "enabledMcpjsonServers": [
    "playwright",
    "context7"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "PY=\"$CLAUDE_PROJECT_DIR/backend/.venv/bin/python\"; [ -x \"$PY\" ] || PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PY=\"$CLAUDE_PROJECT_DIR/backend/.venv/bin/python\"; [ -x \"$PY\" ] || PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "PY=\"$CLAUDE_PROJECT_DIR/backend/.venv/bin/python\"; [ -x \"$PY\" ] || PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_files.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "PY=\"$CLAUDE_PROJECT_DIR/backend/.venv/bin/python\"; [ -x \"$PY\" ] || PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_quality.py\"",
            "timeout": 90,
            "statusMessage": "Verificando qualidade…"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "code-reviewer|qa-tester",
        "hooks": [
          {
            "type": "command",
            "command": "PY=\"$CLAUDE_PROJECT_DIR/backend/.venv/bin/python\"; [ -x \"$PY\" ] || PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/record_verdict.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PY=\"$CLAUDE_PROJECT_DIR/backend/.venv/bin/python\"; [ -x \"$PY\" ] || PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_gate.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "PY=\"$CLAUDE_PROJECT_DIR/backend/.venv/bin/python\"; [ -x \"$PY\" ] || PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/notify.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "code-reviewer|qa-tester",
        "hooks": [
          {
            "type": "command",
            "command": "PY=\"$CLAUDE_PROJECT_DIR/backend/.venv/bin/python\"; [ -x \"$PY\" ] || PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent_start.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
